# User/Auth Supabase Configuration
SUPABASE_URL=https://your-project-url.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-secret-key

# Content/News Supabase Configuration (Optional, defaults to above if not set)
# If using a separate project for news data:
CONTENT_SUPABASE_URL=https://your-content-project-url.supabase.co
CONTENT_SUPABASE_KEY=your-content-anon-key
CONTENT_SUPABASE_SERVICE_ROLE_KEY=your-content-service-role-key

# Server-side news classification backfill
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini
NUXT_PUBLIC_SITE_URL=https://energystacks.ai
